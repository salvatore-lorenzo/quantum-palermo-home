@article{diekmann2026enablingdeterministicpassivequantum,
  title = {Enabling Deterministic Passive Quantum State Transfer with Giant Atoms},
  author = {Diekmann, Oliver and Di Benedetto, Enrico and Jungwirth, Nicolas and De Bernardis, Daniele and Kuang, Zeyu and Ciccarello, Francesco and Rotter, Stefan and Rabl, Peter and González-Tudela, Alejandro and Gonzalez-Ballestero, Carlos},
  abstract = {Achieving quantum state transfer in passive ways can become a powerful asset for scalable quantum networks. Here, we demonstrate how giant atoms coupled to 1D waveguides provide a platform for such a passive, deterministic transfer. Specifically, we show that when the giant atom's extent is comparable to the width of the emitted wavepacket, this wavepacket can be designed to be time-reversal-symmetric by engineering the positions and strengths of atom-waveguide coupling points. We first derive general analytical conditions under which arbitrary qubit decays can be mapped to wavevector-dependent couplings that guarantee perfect state transfer in the continuum limit of infinitely many coupling points. Then, for experimentally relevant configurations with a finite number of coupling points, we optimize the coupling positions and values. We demonstrate that the transfer fidelity can be boosted well beyond the value for a single coupling point (54%), reaching 87% with only two coupling points and exceeding 99% with ten or more. We further analyze the robustness of the protocol against disorder in the coupling points as well as frequency variations of the qubits and extend the formalism to environments with nonlinear dispersion, showing that dispersion-induced distortions can be fully compensated by judiciously chosen setups. Our results establish giant atoms as a powerful platform for realizing high-fidelity quantum state transfer and demonstrate how time-dependent control can be instead encoded into the device design.},
  journal = {PRX Quantum},
  volume = {7},
  number = {4},
  pages = {043013},
  year = {2026},
  month = {Oct},
  publisher = {American Physical Society (APS)},
  doi = {10.1103/6wcb-nj42},
  url = {https://doi.org/10.1103/6wcb-nj42},
  eprint = {2605.12018},
  archivePrefix = {arXiv},
}
